data_6 = input.text_area("|SPECTRUM:6:20.00|OAL:6:-14.29|SIKA:6:20.00|IKIO:6:-14.29|ALLDIGI:6:-14.29|IZMO:6:20.00|TBZ:5:0.00|FRONTSP:5:-16.67|SERVOTECH:5:-50.00|ARKADE:5:-44.44|SILVERTUC:5:25.00|SKMEGGPROD:5:-28.57|INDOBORAX:4:-50.00|RHETAN:4:-33.33|IRISDOREME:4:-20.00|ORIENTTECH:4:33.33|NELCAST:4:-20.00|MAHASTEEL:3:-25.00|KAPSTON:2:100.00|PAUSHAKLTD:2:-60.00|INFOBEAN:2:-60.00|BGRENERGY:2:-60.00|KNACK:0:0.00|AGL:0:0.00|", "Fund Data Part 6", group=group_data)

show_table = input.bool(true, "Show table on chart", group=group_ui)

//==================================================================
// Lookup: find ticker in encoded data and extract fund count + pct
//==================================================================
all_data = data_1 + data_2 + data_3 + data_4 + data_5 + data_6

ticker = syminfo.ticker
search_key = "|" + ticker + ":"
pos = str.pos(all_data, search_key)

fund_count = 0
fund_pct   = 0.0
found      = false

if pos >= 0
    rest = str.substring(all_data, pos + str.length(search_key))
    end_pos = str.pos(rest, "|")
    val_str = str.substring(rest, 0, end_pos >= 0 ? end_pos : str.length(rest))
    colon_pos = str.pos(val_str, ":")
    if colon_pos >= 0
        fund_count := math.round(str.tonumber(str.substring(val_str, 0, colon_pos)))
        fund_pct   := str.tonumber(str.substring(val_str, colon_pos + 1))
        found      := true

//==================================================================
// Determine tier and trend
//==================================================================
tier_text = fund_count >= 2000 ? "2000+" : fund_count >= 1000 ? "1000+" : fund_count >= 500 ? "500+" : fund_count >= 200 ? "200+" : fund_count >= 100 ? "100+" : fund_count > 0 ? "<100" : "N/A"

tier_color = fund_count >= 2000 ? color.lime : fund_count >= 1000 ? color.aqua : fund_count >= 500 ? color.yellow : fund_count >= 200 ? color.orange : fund_count > 0 ? color.gray : color.gray

trend_arrow = fund_pct > 0 ? "▲" : fund_pct < 0 ? "▼" : "–"
trend_color = fund_pct > 0 ? color.lime : fund_pct < 0 ? color.red : color.gray

//==================================================================
// Bucket Classification
//   Bucket 0: Last two quarters Sales QoQ >= 39%, Market Cap < 30,000 Cr INR, listing age <= 10 years
//   Bucket 1: Last two quarters Sales QoQ >= 39%, OR latest quarter Sales QoQ >= 99%
//   Bucket 2: EPS growth triple-digit (>= 100%) either YoY or QoQ in the latest quarter
//==================================================================

// Fetch fundamentals
EPS_actual     = request.earnings(syminfo.tickerid, earnings.actual, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_on)
EPS_standard   = request.earnings(syminfo.tickerid, earnings.standardized, ignore_invalid_symbol=true, lookahead=barmerge.lookahead_on)
SALES          = request.financial(syminfo.tickerid, "TOTAL_REVENUE", "FQ", ignore_invalid_symbol=true)
totalSharesOut = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ", ignore_invalid_symbol=true)

// Detect quarter boundaries
EPSChanged = EPS_actual != EPS_actual[1] or EPS_standard != EPS_standard[1]
EPSTime    = ta.barssince(EPSChanged) == 0

// Last 3 quarter sales values (need 3 to compute the last two QoQ deltas)
sQ0 = ta.valuewhen(EPSTime, SALES, 0)
sQ1 = ta.valuewhen(EPSTime, SALES, 1)
sQ2 = ta.valuewhen(EPSTime, SALES, 2)

// Sales QoQ growth %
// sCh0 = latest QoQ (Q0 vs Q1), sCh1 = previous QoQ (Q1 vs Q2)
sCh0 = (na(sQ0) or na(sQ1) or sQ1 == 0) ? na : (sQ0 - sQ1) / math.abs(sQ1) * 100
sCh1 = (na(sQ1) or na(sQ2) or sQ2 == 0) ? na : (sQ1 - sQ2) / math.abs(sQ2) * 100

// EPS values across last 5 quarters (latest, prev, 4-back for YoY)
aE0r = ta.valuewhen(EPSTime, EPS_actual, 0)
aE1r = ta.valuewhen(EPSTime, EPS_actual, 1)
aE4r = ta.valuewhen(EPSTime, EPS_actual, 4)
sE0  = ta.valuewhen(EPSTime, EPS_standard, 0)
sE1  = ta.valuewhen(EPSTime, EPS_standard, 1)
sE4  = ta.valuewhen(EPSTime, EPS_standard, 4)

aE0  = na(aE0r) ? sE0 : aE0r
aE1  = na(aE1r) ? sE1 : aE1r
aE4  = na(aE4r) ? sE4 : aE4r

// EPS YoY (latest quarter vs same quarter last year)
epsYoY = (na(aE0) or na(aE4) or aE4 == 0) ? na : (aE0 - aE4) / math.abs(aE4) * 100

// EPS QoQ (latest vs previous quarter)
epsQoQ = (na(aE0) or na(aE1) or aE1 == 0) ? na : (aE0 - aE1) / math.abs(aE1) * 100

// Market cap in Crores
marketCapCr = na(totalSharesOut) ? na : close * totalSharesOut / 10000000

// Years listed — proxy for listing age using earliest bar in chart history.
// NOTE: Pine Script has no real IPO-date API. This relies on TradingView having
// loaded the full price history for the symbol. For liquid NSE/BSE stocks this
// is usually accurate; on illiquid/thin tickers or restricted chart history
// it can UNDERSTATE listing age (i.e. show < 10 years for a stock listed > 10).
// If precise verification matters, cross-check externally.
var int firstBarTimestamp = na
if barstate.isfirst
    firstBarTimestamp := time

yearsListed = na(firstBarTimestamp) ? na : (time - firstBarTimestamp) / (365.25 * 24.0 * 60.0 * 60.0 * 1000.0)

// Bucket 0
b0Sales0 = na(sCh0) ? false : sCh0 >= 39
b0Sales1 = na(sCh1) ? false : sCh1 >= 39
b0Cap    = na(marketCapCr) ? false : marketCapCr < 30000
b0Ipo    = na(yearsListed) ? false : yearsListed <= 10
matchesB0 = b0Sales0 and b0Sales1 and b0Cap and b0Ipo

// Bucket 1
b1Two39 = (na(sCh0) ? false : sCh0 >= 39) and (na(sCh1) ? false : sCh1 >= 39)
b1One99 = na(sCh0) ? false : sCh0 >= 99
matchesB1 = b1Two39 or b1One99

// Bucket 2 — EPS growth in triple digits (>= 100%) either YoY or QoQ
b2YoY = na(epsYoY) ? false : epsYoY >= 100
b2QoQ = na(epsQoQ) ? false : epsQoQ >= 100
matchesB2 = b2YoY or b2QoQ

// Build bucket text
bucketParts = ""
if matchesB0
    bucketParts := "0"
else if matchesB1
    bucketParts := "1"
if matchesB2
    bucketParts := bucketParts == "" ? "2" : bucketParts + ", 2"

bucketAny   = matchesB0 or matchesB1 or matchesB2
bucketText  = bucketAny ? "Bucket " + bucketParts : "—"
bucketColor = matchesB0 ? color.lime : matchesB1 ? color.yellow : matchesB2 ? color.aqua : color.gray

//==================================================================
// Table display (2 rows: fund ownership + bucket)
//==================================================================
var table t = table.new(position.top_right, 4, 2, border_width=1)

if barstate.islast and show_table
    table.clear(t, 0, 0, 3, 1)

    // Row 0: fund ownership
    table.cell(t, 0, 0, "Fund ownership", text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 1, 0, found ? tier_text : "N/A", text_color=tier_color, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 2, 0, found ? trend_arrow : "", text_color=trend_color, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 3, 0, found ? str.tostring(fund_count) : "", text_color=color.white, bgcolor=color.black, text_size=size.normal)

    // Row 1: bucket
    table.cell(t, 0, 1, "Bucket",   text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 1, 1, bucketText, text_color=bucketColor, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 2, 1, "",         text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.cell(t, 3, 1, "",         text_color=color.white, bgcolor=color.black, text_size=size.normal)
    table.merge_cells(t, 1, 1, 3, 1)

//==================================================================
// Hidden outputs for screener
//==================================================================
plot(fund_count, "No. of Funds", display=display.none)
plot(fund_pct, "Fund % Change", display=display.none)
plot(fund_count >= 2000 ? 4 : fund_count >= 1000 ? 3 : fund_count >= 500 ? 2 : fund_count >= 200 ? 1 : 0, "Fund Tier", display=display.none)
plot(matchesB0 ? 0 : matchesB1 ? 1 : matchesB2 ? 2 : -1, "Bucket", display=display.none)
plot(marketCapCr, "Market Cap (Cr)", display=display.none)
plot(yearsListed, "Years Listed", display=display.none)
plot(sCh0, "Sales QoQ Q0", display=display.none)
plot(sCh1, "Sales QoQ Q1", display=display.none)
plot(epsYoY, "EPS YoY", display=display.none)
plot(epsQoQ, "EPS QoQ", display=display.none)
